{
  "rules": {
    "rooms": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$rid": {
        ".write": "auth !== null && ((newData.exists() && (!root.child('roomPw').child($rid).exists() || data.child('uid').val() === auth.uid || root.child('roomPwCheck').child($rid).child(auth.uid).val() === root.child('roomPw').child($rid).val() || (auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true))) || (!newData.exists() && (!data.child('uid').exists() || data.child('uid').val() === '' || data.child('uid').val() === auth.uid || (auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true) || (data.child('createdAt').val() < now - 2419200000 && (!data.child('playStartedAt').exists() || data.child('playStartedAt').val() < now - 2419200000) && (!data.child('lastActive').exists() || data.child('lastActive').val() < now - 2419200000)))))",
        "uid":       { ".validate": "!data.exists() || newData.val() === data.val()" },
        "hostId":    { ".validate": "!data.exists() || newData.val() === data.val()" },
        "createdAt": { ".validate": "!data.exists() || newData.val() === data.val()" },
        "pw":        { ".validate": "!data.exists() || data.val() === '' || newData.val() === data.val()" },
        "hasPw":     { ".validate": "newData.isBoolean() && (newData.val() === false || newData.parent().parent().parent().child('roomPw').child($rid).exists())" }
      }
    },
    "roomPw": {
      ".read": "auth !== null && auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true",
      "$rid": {
        ".write": "auth !== null && (newData.parent().parent().child('rooms').child($rid).child('uid').val() === auth.uid || (auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 8"
      }
    },
    "roomPwCheck": {
      ".read": "auth !== null && auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true",
      "$rid": {
        ".write": "auth !== null && auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true",
        "$uid": {
          ".write": "auth !== null && (auth.uid === $uid || (auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true))",
          ".validate": "newData.isString() && newData.val() === root.child('roomPw').child($rid).val()"
        }
      }
    },
    "archive": {
      ".read": "auth !== null && auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true",
      "rooms": {
        "$rid": {
          ".write": "auth !== null && !data.exists() && root.child('rooms').child($rid).exists()",
          ".validate": "newData.hasChildren(['c', 'l']) && newData.child('c').val() === root.child('rooms').child($rid).child('createdAt').val() && newData.child('l').val() < now - 2419200000",
          "c":   { ".validate": "newData.isNumber()" },
          "l":   { ".validate": "newData.isNumber()" },
          "s":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "src": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        }
      }
    },
    "hosts": {
      ".read": true,
      ".write": "auth !== null"
    },
    "stats": {
      "songs": {
        ".read": true,
        ".write": "auth !== null",
        ".indexOn": ["count"]
      }
    },
    "users": {
      "$uid": {
        ".read":  "auth !== null && auth.uid === $uid",
        ".write": false
      }
    },
    "analytics": {
      ".read": "auth !== null && auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true",
      "sessions": {
        ".indexOn": ["start"],
        "$sid": {
          ".write": "auth !== null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) || (auth.token.email === 'n.furfur@gmail.com' && auth.token.email_verified === true))",
          ".validate": "newData.hasChildren(['uid', 'start', 'last'])",
          "uid":   { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
          "start": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
          "last":  { ".validate": "newData.isNumber()" },
          "src":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "first": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "land":  { ".validate": "newData.isString() && newData.val().length <= 12" },
          "dev":   { ".validate": "newData.isString() && newData.val().length <= 12" },
          "app":   { ".validate": "newData.isString() && newData.val().length <= 12" },
          "role":  { ".validate": "newData.isString() && newData.val().length <= 12" },
          "steps": { "$k": { ".validate": "newData.isNumber()" } },
          "fails": { "$k": { ".validate": "newData.isNumber() && newData.val() <= 1000" } },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
