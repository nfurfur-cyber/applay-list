{
  "rules": {
    "rooms": {
      ".read": true,
      ".write": "auth !== null",
      ".indexOn": ["createdAt"]
    },
    "hosts": {
      ".read": true,
      ".write": "auth !== null"
    },
    "stats": {
      "songs": {
        ".read": true,
        ".write": "auth !== null",
        ".indexOn": ["count"]
      }
    },
    "users": {
      "$uid": {
        ".read":  "auth !== null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
